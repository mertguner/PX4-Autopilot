CONFIG_BOARD_ARCHITECTURE="cortex-m7"        # Kartın işlemci mimarisi (PX4 build target CPU)
CONFIG_BOARD_SERIAL_GPS1="/dev/ttyS0"        # GPS1 portu olarak kullanılacak seri cihaz
CONFIG_BOARD_SERIAL_GPS2="/dev/ttyS2"        # GPS2 portu olarak kullanılacak seri cihaz
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS1"        # Telemetri 1 portu (MAVLink)
CONFIG_BOARD_SERIAL_TEL2="/dev/ttyS3"        # Telemetri 2 portu (MAVLink)
CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"       # Derleme için kullanılacak toolchain
CONFIG_BOARD_UAVCAN_TIMER_OVERRIDE=2         # UAVCAN zamanlayıcı kaynağı seçimi

CONFIG_COMMON_BAROMETERS=y                   # Ortak barometre sensör altyapısı
CONFIG_COMMON_DISTANCE_SENSOR=y              # Ortak mesafe sensörü (rangefinder) altyapısı
CONFIG_COMMON_GNSS=y                         # Ortak GNSS altyapısı
CONFIG_COMMON_GRAVITY_FUSION=y               # Ortak gravity fusion altyapısı
CONFIG_COMMON_MAGNETOMETER=y                 # Ortak manyetometre altyapısı
CONFIG_COMMON_OPTICAL_FLOW=y                 # Ortak optical flow sensör altyapısı
CONFIG_COMMON_RC=y                           # Ortak RC giriş altyapısı
CONFIG_COMMON_TELEMETRY=y                    # Ortak telemetri altyapısı
CONFIG_COMMON_TERRAIN=y                      # Ortak terrain (zemin yüksekliği) altyapısı

CONFIG_DRIVERS_ADC_BOARD_ADC=y               # Kart üzerindeki ADC sürücüsü
CONFIG_DRIVERS_BAROMETER_MS5611=y            # MS5611 barometre sürücüsü
CONFIG_DRIVERS_CDCACM_AUTOSTART=y            # USB CDC-ACM (Virtual COM port) otomatik başlatma
CONFIG_DRIVERS_GNSS_SEPTENTRIO=y             # Septentrio GNSS sürücüsü (Mosaic-H gibi)
CONFIG_DRIVERS_IMU_ANALOG_DEVICES_ADIS16470=y# ADIS16470 IMU sürücüsü
CONFIG_DRIVERS_IMU_INVENSENSE_ICM20689=y     # ICM20689 IMU sürücüsü
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42688P=y    # ICM42688P IMU sürücüsü
CONFIG_DRIVERS_MAGNETOMETER_RM3100=y         # RM3100 manyetometre sürücüsü
CONFIG_DRIVERS_MAGNETOMETER_ISENTEK_IST8310=y# IST8310 manyetometre sürücüsü
CONFIG_DRIVERS_PWM_OUT=y                     # PWM çıkış sürücüsü (motor/servo)
CONFIG_DRIVERS_RC_INPUT=y                    # Genel RC giriş yönetici modülü
CONFIG_DRIVERS_RC_SBUS_RC=y                  # SBUS RC protokol sürücüsü
CONFIG_DRIVERS_SAFETY_BUTTON=y               # Safety (arming) butonu sürücüsü
CONFIG_DRIVERS_UAVCAN=y                      # UAVCAN/DroneCAN sürücüsü

CONFIG_EKF2_BAROMETER=y                      # EKF2'de barometre füzyonu kodu
CONFIG_EKF2_GNSS=y                           # EKF2'de GNSS füzyonu kodu
CONFIG_EKF2_GNSS_YAW=y                       # EKF2'de çift anten GNSS yaw füzyonu
CONFIG_EKF2_GRAVITY_FUSION=y                 # EKF2'de gravity fusion kodu
CONFIG_EKF2_MAGNETOMETER=y                   # EKF2'de manyetometre füzyonu
CONFIG_EKF2_OPTICAL_FLOW=y                   # EKF2'de optical flow füzyonu
CONFIG_EKF2_RANGE_FINDER=y                   # EKF2'de rangefinder füzyonu
CONFIG_EKF2_TERRAIN=y                        # EKF2'de terrain yüksekliği tahmini

CONFIG_MODULES_BATTERY_STATUS=y              # Pil durumu modülü
CONFIG_MODULES_COMMANDER=y                   # Komuta ve durum yönetimi modülü
CONFIG_MODULES_CONTROL_ALLOCATOR=y           # Kontrol ayırıcı (Control Allocation) modülü
CONFIG_MODULES_DATAMAN=y                     # Veri depolama modülü
CONFIG_MODULES_EKF2=y                        # EKF2 ana modülü
CONFIG_MODULES_ESTIMATOR_STATUS=y            # Estimator durum raporlama modülü
CONFIG_MODULES_EVENTS=y                      # Sistem olay modülü
CONFIG_MODULES_FLIGHT_MODE_MANAGER=y         # Uçuş modu yöneticisi
CONFIG_MODULES_GYRO_CALIBRATION=y            # Gyro kalibrasyon modülü
CONFIG_MODULES_GYRO_FFT=y                    # Gyro FFT (titreşim analizi ve notch filter) modülü
CONFIG_MODULES_LAND_DETECTOR=y               # İniş algılama modülü
CONFIG_MODULES_LOAD_MON=y                    # Sistem yük monitörü
CONFIG_MODULES_LOGGER=y                      # Uçuş log kaydedici
CONFIG_MODULES_MAG_BIAS_ESTIMATOR=y          # Manyetometre bias tahmin modülü
CONFIG_MODULES_MANUAL_CONTROL=y              # Manuel kontrol modülü (kumanda)
CONFIG_MODULES_MAVLINK=y                     # MAVLink iletişim modülü
CONFIG_MODULES_MC_ATT_CONTROL=y              # Multicopter attitude kontrol modülü
CONFIG_MODULES_MC_AUTOTUNE_ATTITUDE_CONTROL=y# Multicopter PID autotune modülü
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=y   # Hover thrust tahmin modülü
CONFIG_MODULES_MC_POS_CONTROL=y              # Multicopter pozisyon kontrol modülü
CONFIG_MODULES_MC_RATE_CONTROL=y             # Multicopter rate kontrol modülü
CONFIG_MODULES_NAVIGATOR=y                   # Görev/Navigasyon yöneticisi
CONFIG_MODULES_RC_UPDATE=y                   # RC veri güncelleme modülü
CONFIG_MODULES_SENSORS=y                     # Sensör yönetim modülü
CONFIG_MODULES_TEMPERATURE_COMPENSATION=y    # Sıcaklık kompanzasyonu modülü
CONFIG_MODULES_UAVCAN=y                      # UAVCAN modülü

CONFIG_MAVLINK_DIALECT="development"         # MAVLink mesaj seti olarak 'development' kullan

CONFIG_SYSTEMCMDS_MAVLINK=y                  # MAVLink CLI komutu
CONFIG_SYSTEMCMDS_NSHTERM=y                  # NuttShell terminal komutu
CONFIG_SYSTEMCMDS_PARAM=y                    # Parametre yönetim komutu
CONFIG_SYSTEMCMDS_REBOOT=y                   # Yeniden başlatma komutu
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=y           # uORB topic listener komutu
CONFIG_SYSTEMCMDS_UORB=y                     # uORB bilgi komutu
CONFIG_SYSTEMCMDS_VER=y                      # Versiyon bilgisi komutu
CONFIG_SYSTEMCMDS_WORK_QUEUE=y               # Work queue yönetim komutu
